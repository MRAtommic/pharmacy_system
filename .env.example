# Copy this file to ".env" (same folder) and fill in your own values. Never commit the real .env.

# ── Security (set these before exposing the server to the internet) ─────────────
STAFF_PASSCODE=change-me-to-a-long-random-passcode
# Signs login sessions. Leave empty to auto-generate a random key in ".secret_key"
FLASK_SECRET_KEY=
# Restrict Google sign-in to these accounts (comma-separated). If both are empty, ANY Google account can sign in.
ALLOWED_LOGIN_EMAILS=
ALLOWED_LOGIN_DOMAINS=
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0

# ── Server / URLs ───────────────────────────────────────────────────────────────
PHARMACY_PORT=5005
# Public address of this app (LINE links, QR codes, OAuth). Example: https://pharmacy.example.com
BASE_URL=
# Optional: extra hostnames allowed for the Google OAuth redirect (e.g. an ngrok domain), comma-separated
OAUTH_TRUSTED_HOSTS=
# Optional: force the exact OAuth redirect URI registered in Google Cloud
OAUTH2_REDIRECT_URI=
# Set to 1 only if you really want to load the parent folder's .env files (other projects' secrets)
PHARMACY_USE_PARENT_ENV=0

# ── LINE Messaging API ──────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# PIN that staff type in LINE ("รหัส 123456") to get permission to dispense. No default: empty = feature disabled.
LINE_STAFF_PIN=
PHARMACY_LINE_TARGET_ID=

# ── Google Workspace ────────────────────────────────────────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
PHARMACY_SPREADSHEET_ID=
PHARMACY_DRIVE_FOLDER_ID=

# ── Organisation printed on stock cards / requisition forms ────────────────────
ORG_NAME=
ORG_OPENING_SIGN=
ORG_REQUESTER_NAME=
ORG_REQUESTER_TITLE=
ORG_DISPENSER_NAME=
ORG_DISPENSER_TITLE=
ORG_AUTHORIZER_NAME=
ORG_AUTHORIZER_TITLE=
ORG_RECEIVER_NAME=
ORG_RECEIVER_TITLE=
